# Strapi Configuration
STRAPI_BASE_URL=http://localhost:1337

# API Delays (in milliseconds)
DELAY_MS=2000

# YouTube API Configuration (for YouTube scripts)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Test Mode (optional - for testing scripts with limited data)
TEST_MODE=false

# Analysis API Configuration (if different from default)
# ANALYSIS_API_URL=http://localhost:4000

# Gemini AI Configuration (for auto-categorization)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Email (Resend) — used by send-broadcast and Strapi mail
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_DEFAULT_FROM_EMAIL=noreply@religousphilosophy.com
RESEND_DEFAULT_REPLY_TO_EMAIL=noreply@religousphilosophy.com
RESEND_DEFAULT_AUDIENCE_ID=e5d7ecb0-d089-49a1-908e-6423de637cf9