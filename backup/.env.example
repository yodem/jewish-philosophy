STRAPI_BASE_URL=https://gorgeous-power-cb8382b5a9.strapiapp.com
# Use a dedicated read-only (Full access NOT needed) Strapi API token
STRAPI_API_TOKEN=your-api-token-here
# Where backups go (default: ./data next to the script). Contains PII - keep private.
BACKUP_OUT_DIR=/home/yodem/backups/strapi
# Delete timestamped run dirs older than this many days after a successful run
BACKUP_KEEP_DAYS=30

# --- Stale-backup alert (check-backup-fresh.py) ---
# Alert when the newest OK run is older than this many hours, or the latest run failed
BACKUP_MAX_AGE_HOURS=26
# Telegram (preferred): read an existing chmod-600 creds file at send time, nothing copied
TELEGRAM_ENV_FILE=/home/yodem/.claude/sync-and-update.env
TELEGRAM_TOKEN_VAR=WIKI_TG_TOKEN
TELEGRAM_CHAT_VAR=WIKI_TG_CHAT
# Email (optional second channel): a send-only Resend API key ("Sending access")
RESEND_API_KEY=re_your-send-only-key
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=noreply@religousphilosophy.com
